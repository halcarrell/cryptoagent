//@version=6
// =============================================================
// Screener Confirmation Signals
//   - Confirms entries with technicals: RSI bounce, VWAP reclaim,
//     volume spike, EMA trend
//   - Fires a webhook alert with entry/stop/target to the Python server
//   - Score checking is done SERVER-SIDE — no daily updates needed here
//   - Set your webhook auth token once in the Alert / Webhook settings
// =============================================================
indicator("Screener Confirmation", overlay=true, max_labels_count=50)

// ===== Confirmation Filters =====
g_filt = "Confirmation Filters"
use_rsi    = input.bool(true,  "RSI bounce (was oversold)", group=g_filt)
use_vwap   = input.bool(true,  "VWAP reclaim",              group=g_filt)
use_vol    = input.bool(true,  "Volume spike (1.5x avg)",   group=g_filt)
use_trend  = input.bool(true,  "EMA50 > EMA200 trend",      group=g_filt)

// ===== Risk Settings =====
g_risk = "Risk"
atr_stop_mult   = input.float(1.5, "ATR stop multiplier",   group=g_risk)
atr_target_mult = input.float(3.0, "ATR target multiplier", group=g_risk)

// ===== Webhook =====
g_alert    = "Alert / Webhook"
auth_token = input.string("PASTE_YOUR_TOKEN_HERE", "Webhook auth token", group=g_alert,
     tooltip="Copy WEBHOOK_AUTH_TOKEN from Railway → your service → Variables")

// ===== Indicators =====
rsi_v            = ta.rsi(close, 14)
rsi_was_oversold = ta.barssince(rsi_v < 30) < 5
vwap_v           = ta.vwap(hlc3)
crossed_vwap     = ta.crossover(close, vwap_v)
vol_avg          = ta.sma(volume, 20)
vol_spike        = volume > vol_avg * 1.5
ema50            = ta.ema(close, 50)
ema200           = ta.ema(close, 200)
trend_up         = ema50 > ema200
atr_v            = ta.atr(14)

// ===== Signal Conditions =====
rsi_ok   = not use_rsi   or rsi_was_oversold
vwap_ok  = not use_vwap  or crossed_vwap
vol_ok   = not use_vol   or vol_spike
trend_ok = not use_trend or trend_up

long_entry = rsi_ok and vwap_ok and vol_ok and trend_ok

stop_price   = close - atr_v * atr_stop_mult
target_price = close + atr_v * atr_target_mult

// ===== Plot =====
plot(vwap_v, color=color.orange, title="VWAP")
plot(ema50,  color=color.blue,   title="EMA50")
plot(ema200, color=color.purple, title="EMA200")
bgcolor(long_entry ? color.new(color.green, 90) : na, title="Signal active")

if long_entry
    label.new(bar_index, low,
              "SIGNAL\nE:" + str.tostring(close, format.mintick) +
              "\nS:" + str.tostring(stop_price, format.mintick) +
              "\nT:" + str.tostring(target_price, format.mintick),
              color=color.green, textcolor=color.white,
              style=label.style_label_up, yloc=yloc.belowbar)

// ===== Webhook Alert =====
// Server checks: is this coin in today's top 10? Score high enough? R:R valid?
// Pine Script just confirms the technical setup and sends the prices.
if long_entry
    payload = '{"auth":"'    + auth_token               + '"' +
              ',"symbol":"'  + syminfo.ticker            + '"' +
              ',"exchange":"' + syminfo.prefix           + '"' +
              ',"side":"long"'                                  +
              ',"entry":'    + str.tostring(close)       +
              ',"stop":'     + str.tostring(stop_price)  +
              ',"target":'   + str.tostring(target_price)+
              ',"rsi":'      + str.tostring(rsi_v)       +
              ',"time":"'    + str.format_time(time, "yyyy-MM-dd'T'HH:mm:ssZ", "UTC") + '"}'
    alert(payload, alert.freq_once_per_bar_close)

alertcondition(long_entry, title="Long entry confirmed",
     message="Technical signal on {{ticker}} — check Python server for decision")
