//@version=6
// =============================================================
// Screener Confirmation Signals
//   - Confirms momentum entries AND overextended reversal shorts
//   - Alert format: human-readable header + JSON body
//     Mobile notification shows the header line only.
//     Webhook server extracts the JSON from the full payload.
//   - Set auth token once in Alert/Webhook settings
//
// TIMEFRAME GUIDE:
//   4H — original, fewer signals, higher quality (recommended for beginners)
//   1H — 4× more signals per day, faster entry, slightly noisier
//   Apply this indicator on BOTH timeframes and create alerts on both
//   for the most real-time coverage. The server handles all filtering.
// =============================================================
indicator("Screener Confirmation", overlay=true, max_labels_count=50)

// ===== Confirmation Filters (Longs) =====
g_filt = "Long Confirmation Filters"
use_trend  = input.bool(true,  "EMA50 > EMA200 (uptrend)",           group=g_filt)
use_vol    = input.bool(true,  "Volume spike (1.5× avg)",             group=g_filt)
use_vwap   = input.bool(true,  "Above VWAP",                         group=g_filt)
use_green  = input.bool(true,  "Green bar (close > open)",            group=g_filt)
use_rsi    = input.bool(false, "RSI not overbought (< 70)",           group=g_filt,
     tooltip="Off by default — only enable if you're getting too many signals")

// ===== Short Filters =====
g_short = "Short Confirmation Filters"
use_shorts   = input.bool(true,  "Enable short signals",              group=g_short,
     tooltip="Two setups: (1) overbought bounce — RSI > 60 + VWAP extended + volume; (2) failed EMA50 bounce — price rejected at EMA50 resistance. Server applies regime check.")
use_s_trend  = input.bool(true,  "EMA50 < EMA200 (downtrend) or flat", group=g_short)
use_s_rsi    = input.bool(true,  "RSI elevated (> 60) for overbought setup", group=g_short)
use_s_vwap   = input.bool(true,  "Price extended above VWAP (> 1%)",  group=g_short)
use_s_vol    = input.bool(true,  "Volume spike (1.5× avg — distribution)", group=g_short)

// ===== Risk Settings =====
g_risk = "Risk"
atr_stop_mult         = input.float(1.5, "ATR stop multiplier",         group=g_risk)
atr_target_mult       = input.float(3.0, "ATR long target multiplier",  group=g_risk)
atr_short_target_mult = input.float(4.0, "ATR short target multiplier", group=g_risk,
     tooltip="Wider target on shorts to capture full bear-market moves. 4.0× ATR gives ~2.67:1 R:R.")

// ===== Session Gate =====
// Research: 13-17 UTC = peak volume + cleanest momentum (EU/US overlap).
// 02-06 UTC = lowest volume, widest spreads, most noise (worst entries).
g_session        = "Session Gate"
use_session      = input.bool(true,  "Gate longs to EU/US session (12–18 UTC)", group=g_session,
     tooltip="Research-backed: 13-17 UTC has peak liquidity and momentum quality. Longs need this — shorts don't.")
use_short_session = input.bool(false, "Gate shorts to session too (default: off)", group=g_session,
     tooltip="Off = shorts fire any time of day. Bear-market bounces happen in Asian session too.")
session_hour  = hour(time, "UTC")
session_ok    = not use_session       or (session_hour >= 12 and session_hour < 18)
s_session_ok  = not use_short_session or (session_hour >= 12 and session_hour < 18)

// ===== Webhook =====
g_alert    = "Alert / Webhook"
auth_token = input.string("d0338ca4f3cc6be20b233142dfd1317277fbca1ec6425cc1076e9365bc803cd3", "Webhook auth token", group=g_alert,
     tooltip="Copy WEBHOOK_AUTH_TOKEN from Railway → your service → Variables")

// ===== Indicators =====
rsi_v   = ta.rsi(close, 14)
// ta.vwma is a rolling 20-bar volume-weighted moving average — identical signal
// to VWAP for our bar-close alerts but no session reset, no repainting warning.
vwap_v  = ta.vwma(hlc3, 20)
vol_avg = ta.sma(volume, 20)
ema50   = ta.ema(close, 50)
ema200  = ta.ema(close, 200)
atr_v   = ta.atr(14)

// ===== Long Conditions =====
trend_ok = not use_trend or ema50 > ema200
vol_ok   = not use_vol   or volume > vol_avg * 1.5
vwap_ok  = not use_vwap  or close > vwap_v
green_ok = not use_green or close > open
rsi_ok   = not use_rsi   or rsi_v < 70

long_entry = trend_ok and vol_ok and vwap_ok and green_ok and rsi_ok and session_ok

// ===== Short Conditions =====
// Setup 1 — Overbought bounce: RSI > 60, extended above VWAP, distribution volume, red bar.
// Setup 2 — Failed EMA50 bounce: price tagged EMA50 resistance in last 5 bars, now
//           rolling back below it on above-average volume. Classic bear market rejection.
// Server applies score cap check + regime gate before opening any short.
s_trend_ok = not use_s_trend or ema50 <= ema200
s_rsi_ok   = not use_s_rsi   or rsi_v > 60
s_vwap_ok  = not use_s_vwap  or close > vwap_v * 1.01
s_vol_ok   = not use_s_vol   or volume > vol_avg * 1.5
red_ok     = close < open

// Failed EMA50 bounce: highest high in last 5 bars reached EMA50 zone, close now below it
s_bounce_high = ta.highest(high, 5)
s_bounce_ok   = s_bounce_high >= ema50 * 0.98 and close < ema50

s_overbought = s_rsi_ok and s_vwap_ok and s_vol_ok and red_ok
s_ema_reject = s_bounce_ok and volume > vol_avg * 1.2 and red_ok

short_entry = use_shorts and s_trend_ok and s_session_ok and not long_entry
           and (s_overbought or s_ema_reject)

// ===== Stop / Target =====
long_stop    = close - atr_v * atr_stop_mult
long_target  = close + atr_v * atr_target_mult
short_stop   = close + atr_v * atr_stop_mult
short_target = close - atr_v * atr_short_target_mult  // wider target for shorts

// ===== R:R =====
long_rr  = atr_target_mult       / atr_stop_mult
short_rr = atr_short_target_mult / atr_stop_mult

// ===== Regime (mirrors server-side three-state gate) =====
ema_gap_pct  = (ema50 - ema200) / ema200 * 100
regime_bull  = ema_gap_pct >  2.0
regime_bear  = ema_gap_pct < -2.0
regime_side  = not regime_bull and not regime_bear

// ===== Plot =====
plot(vwap_v, color=color.orange,       title="VWAP")
plot(ema50,  color=color.blue,         title="EMA50",  linewidth=2)
plot(ema200, color=color.purple,       title="EMA200", linewidth=2)
bgcolor(regime_bull ? color.new(color.green, 97) : na, title="Bull regime")
bgcolor(regime_side ? color.new(color.yellow,97) : na, title="Sideways regime")
bgcolor(regime_bear ? color.new(color.red,   97) : na, title="Bear regime")
bgcolor(long_entry  ? color.new(color.green, 80) : na, title="Long signal")
bgcolor(short_entry ? color.new(color.red,   80) : na, title="Short signal")

// EMA gap label — draw every bar, Pine automatically keeps only the latest visible.
// Avoids barstate.islast which contributes to the repainting warning.
var label regime_lbl = na
label.delete(regime_lbl)
regime_txt = regime_bull ? "BULL" : regime_bear ? "BEAR" : "SIDE"
regime_col = regime_bull ? color.green : regime_bear ? color.red : color.orange
regime_lbl := label.new(bar_index, ema50,
              regime_txt + " " + str.tostring(math.round(ema_gap_pct, 1)) + "%",
              color=regime_col, textcolor=color.white,
              style=label.style_label_left, size=size.small)

if long_entry
    label.new(bar_index, low,
              "🟢 LONG\nE:" + str.tostring(close, format.mintick) +
              "\nS:" + str.tostring(long_stop, format.mintick) +
              "\nT:" + str.tostring(long_target, format.mintick),
              color=color.green, textcolor=color.white,
              style=label.style_label_up, yloc=yloc.belowbar)

if short_entry
    label.new(bar_index, high,
              "🔴 SHORT\nE:" + str.tostring(close, format.mintick) +
              "\nS:" + str.tostring(short_stop, format.mintick) +
              "\nT:" + str.tostring(short_target, format.mintick),
              color=color.red, textcolor=color.white,
              style=label.style_label_down, yloc=yloc.abovebar)

// ===== Alerts =====
// Message format: human-readable header on line 1 (shown in mobile push notification),
// compact JSON on line 2 (parsed by webhook server).
// Mobile shows only the first ~80 characters — the header fits perfectly.

if long_entry
    stop_pct   = math.round((long_stop   - close) / close * 100, 1)
    target_pct = math.round((long_target - close) / close * 100, 1)
    header  = "🟢 LONG "  + syminfo.ticker +
              " @ "       + str.tostring(close,       format.mintick) +
              "  SL "     + str.tostring(stop_pct)   + "%" +
              "  TP +"    + str.tostring(target_pct) + "%" +
              "  R:R "    + str.tostring(long_rr,     "#.#") + ":1" +
              "  RSI "    + str.tostring(math.round(rsi_v, 1))
    payload = '{"auth":"'     + auth_token                                              + '"' +
              ',"symbol":"'   + syminfo.ticker                                          + '"' +
              ',"exchange":"' + syminfo.prefix                                          + '"' +
              ',"side":"long"'                                                                +
              ',"entry":'     + str.tostring(close)                                         +
              ',"stop":'      + str.tostring(long_stop)                                     +
              ',"target":'    + str.tostring(long_target)                                   +
              ',"rsi":'       + str.tostring(math.round(rsi_v, 2))                         +
              ',"time":"'     + str.format_time(time, "yyyy-MM-dd'T'HH:mm:ssZ", "UTC") + '"}'
    alert(header + "\n" + payload, alert.freq_once_per_bar_close)

if short_entry
    stop_pct   = math.round((short_stop   - close) / close * 100, 1)
    target_pct = math.round((short_target - close) / close * 100, 1)
    header  = "🔴 SHORT " + syminfo.ticker +
              " @ "       + str.tostring(close,       format.mintick) +
              "  SL +"    + str.tostring(stop_pct)   + "%" +
              "  TP -"    + str.tostring(math.abs(target_pct)) + "%" +
              "  R:R "    + str.tostring(short_rr,    "#.#") + ":1" +
              "  RSI "    + str.tostring(math.round(rsi_v, 1))
    payload = '{"auth":"'     + auth_token                                              + '"' +
              ',"symbol":"'   + syminfo.ticker                                          + '"' +
              ',"exchange":"' + syminfo.prefix                                          + '"' +
              ',"side":"short"'                                                               +
              ',"entry":'     + str.tostring(close)                                         +
              ',"stop":'      + str.tostring(short_stop)                                    +
              ',"target":'    + str.tostring(short_target)                                  +
              ',"rsi":'       + str.tostring(math.round(rsi_v, 2))                         +
              ',"time":"'     + str.format_time(time, "yyyy-MM-dd'T'HH:mm:ssZ", "UTC") + '"}'
    alert(header + "\n" + payload, alert.freq_once_per_bar_close)

alertcondition(long_entry,  title="Long entry confirmed",  message="Long signal on {{ticker}}")
alertcondition(short_entry, title="Short entry confirmed", message="Short signal on {{ticker}}")
